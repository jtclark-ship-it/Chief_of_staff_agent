# Path to Google OAuth client secret JSON file (required)
GOOGLE_OAUTH_CLIENT_SECRET_PATH=./client_secret.json

# Base URL for deployed environment (required in production)
BASE_URL=http://localhost:8000

# Token storage configuration
TOKEN_STORE_TYPE=dev_file
TOKEN_STORE_PATH=./token.json

# Timezone and range defaults
DEFAULT_TIMEZONE=America/Denver
MAX_LOOKAHEAD_DAYS=30
MAX_LOOKBACK_DAYS=30

# Event limits
MAX_EVENTS_DEFAULT=250

# Clamping behavior (true = clamp out-of-range; false = return 400)
ALLOW_CLAMPING=false

# Logging
LOG_LEVEL=INFO
